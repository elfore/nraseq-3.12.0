/*
 * =====================================================================
 * 环境配置 — nf-core/rnaseq 本地全兼容模式 (V6 - 系统化下游补强)
 * =====================================================================
 */

process {
    executor = 'sge'

    // 1. 全局配置 (严格锁定，保护 STAR/Salmon/Picard 缓存)
    env {
        PATH = [
            "/mnt/gpfs/Users/yangjinxurong/software/miniconda3/envs/rnaseq/bin",
            "/mnt/gpfs/Users/lilei/software/miniconda3/bin",
            "/mnt/gpfs/Users/huyangzhirong/02.sofware/miniconda3/bin",
            "/usr/local/bin",
            "/usr/bin",
            "/bin",
            '$PATH'
        ].join(':')
    }

    beforeScript = {
        """
        mkdir -p .local_bin
        ln -sf /mnt/gpfs/Users/yangjinxurong/software/miniconda3/envs/rnaseq/bin/* .local_bin/ 2>/dev/null || true
        
        if [[ -f "/mnt/gpfs/Users/lilei/software/jar/picard.jar" ]]; then
            echo '#!/bin/bash' > .local_bin/picard
            echo 'exec /mnt/gpfs/Users/lilei/software/miniconda3/bin/java -jar /mnt/gpfs/Users/lilei/software/jar/picard.jar "\$@"' >> .local_bin/picard
            chmod +x .local_bin/picard
            ln -sf picard .local_bin/Picard
        fi
        export PATH="\$PWD/.local_bin:\$PATH"
        """.stripIndent()
    }

    // 2. 【精准补强】为报错的下游模块注入所有必需路径
    // 使用更广泛的匹配，确保所有 QC 模块都能找到其工具
    withName: '.*(QUALIMAP|BEDTOOLS|UCSC|DUPRADAR|PRESEQ|MULTIQC|RSEQC|CUSTOM_DUMPSOFTWAREVERSIONS|DESEQ2).*' {
        env {
            PATH = [
                "/mnt/gpfs/Users/yangjinxurong/software/miniconda3/envs/rnaseq/bin",
                "/mnt/gpfs/Users/zhangsijia/software/miniconda3/bin",
                "/mnt/gpfs/Users/huyangzhirong/02.sofware/miniconda3/bin",
                "/mnt/gpfs/Users/lilei/software/miniconda3/bin",
                "/usr/local/bin",
                "/usr/bin",
                "/bin"
            ].join(':')
            LD_LIBRARY_PATH = [
                "/mnt/gpfs/Users/yangjinxurong/software/miniconda3/envs/rnaseq/lib",
                "/mnt/gpfs/Users/lilei/software/miniconda3/lib",
                "/mnt/gpfs/Users/huyangzhirong/02.sofware/miniconda3/lib",
                '$LD_LIBRARY_PATH'
            ].join(':')
            // 确保 R 脚本能找到刚才安装在 rnaseq 环境下的包
            R_LIBS_USER = "/mnt/gpfs/Users/yangjinxurong/software/miniconda3/envs/rnaseq/lib/R/library"
        }
    }
}

docker.enabled      = false
singularity.enabled = false
conda.enabled       = false
